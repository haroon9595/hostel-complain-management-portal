# Application Settings
APP_ENV=development
PORT=8000
HOST=127.0.0.1

# Supabase PostgreSQL Database Connection URL
# Format: postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
# Or Transaction Pooler: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# n8n Automation Status Notification Webhook
# When complaint status changes (e.g. Resolved), FastAPI POSTs status event to this URL
N8N_STATUS_WEBHOOK_URL=

