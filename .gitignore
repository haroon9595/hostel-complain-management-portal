# =============================================================================
# Root .gitignore - Hostel Complaint Management Portal
# =============================================================================

# --- Environment & Sensitive Credentials ---
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert

# --- Backend (Python / FastAPI) ---
backend/.env
backend/.env.*
!backend/.env.example
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/

# --- Frontend (Node.js / Next.js) ---
frontend/.env
frontend/.env.*
!frontend/.env.example
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS & IDE artifacts ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
.agents/
